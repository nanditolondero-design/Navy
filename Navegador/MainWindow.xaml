<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Navegador.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccel_Invoked"/>
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="NewIncognitoAccel_Invoked"/>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTabAccel_Invoked"/>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusAddressAccel_Invoked"/>
            <KeyboardAccelerator Key="F5" Invoked="ReloadAccel_Invoked"/>
        </Grid.KeyboardAccelerators>

        <!-- Solo la tira de pestañas; las páginas web viven en ContentHost -->
        <TabView x:Name="Tabs" Grid.Row="0"
                 VerticalAlignment="Top"
                 IsAddTabButtonVisible="True"
                 CanReorderTabs="True"
                 TabWidthMode="Equal"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged"/>

        <Grid x:Name="Toolbar" Grid.Row="1" Padding="8,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" Grid.Column="0" Click="Back_Click" ToolTipService.ToolTip="Atrás">
                <FontIcon Glyph="&#xE72B;"/>
            </Button>
            <Button x:Name="ForwardBtn" Grid.Column="1" Click="Forward_Click" ToolTipService.ToolTip="Adelante">
                <FontIcon Glyph="&#xE72A;"/>
            </Button>
            <Button x:Name="ReloadBtn" Grid.Column="2" Click="Reload_Click" ToolTipService.ToolTip="Recargar">
                <FontIcon Glyph="&#xE72C;"/>
            </Button>

            <TextBox x:Name="AddressBox" Grid.Column="3"
                     PlaceholderText="Buscá en Google o escribí una dirección"
                     KeyDown="Address_KeyDown"
                     GotFocus="Address_GotFocus"/>

            <TextBlock x:Name="IncognitoBadge" Grid.Column="4" Text="🕶 Incógnito"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="BlockedText" Grid.Column="5" Text="🛡 0"
                       VerticalAlignment="Center" ToolTipService.ToolTip="Solicitudes bloqueadas"/>

            <Button Grid.Column="6" ToolTipService.ToolTip="Menú">
                <FontIcon Glyph="&#xE712;"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Nueva pestaña" Click="NewTab_Click"/>
                        <MenuFlyoutItem Text="Nueva pestaña de incógnito" Click="NewIncognito_Click"/>
                        <MenuFlyoutSeparator/>
                        <ToggleMenuFlyoutItem x:Name="AdblockToggle" Text="Bloquear anuncios" IsChecked="True" Click="AdblockToggle_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="2"/>
    </Grid>
</Window>
