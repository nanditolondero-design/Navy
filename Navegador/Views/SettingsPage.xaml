<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Navegador.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
            <ComboBox x:Name="SearchBox" Header="Buscador predeterminado" MinWidth="260" SelectionChanged="Setting_SelectionChanged"/>

            <ToggleSwitch x:Name="RestoreSwitch" Header="Al abrir, restaurar las pestañas de la última vez" OnContent="Sí" OffContent="No" Toggled="Setting_Toggled"/>
            <ToggleSwitch x:Name="StartPageSwitch" Header="Página de inicio con buscador y favoritos en las pestañas nuevas" OnContent="Sí" OffContent="No" Toggled="Setting_Toggled"/>
            <ToggleSwitch x:Name="BarSwitch" Header="Mostrar la barra de marcadores" OnContent="Sí" OffContent="No" Toggled="Setting_Toggled"/>
            <ToggleSwitch x:Name="SaverSwitch" Header="Ahorro de memoria: suspender las pestañas que no usás hace 5 minutos" OnContent="Activado" OffContent="Desactivado" Toggled="Setting_Toggled"/>

            <TextBlock Text="Escudos (privacidad)" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <ToggleSwitch x:Name="AdblockSwitch" Header="Bloquear anuncios y rastreadores" OnContent="Activado" OffContent="Desactivado" Toggled="Setting_Toggled"/>
            <ToggleSwitch x:Name="HttpsSwitch" Header="Actualizar sitios a HTTPS cuando se pueda" OnContent="Activado" OffContent="Desactivado" Toggled="Setting_Toggled"/>
            <ToggleSwitch x:Name="StripSwitch" Header="Quitar parámetros de seguimiento de los enlaces (utm_, fbclid, gclid...)" OnContent="Activado" OffContent="Desactivado" Toggled="Setting_Toggled"/>
            <ToggleSwitch x:Name="SignalsSwitch" Header="Enviar señales de privacidad (Global Privacy Control y No rastrear)" OnContent="Activado" OffContent="Desactivado" Toggled="Setting_Toggled"/>
            <ComboBox x:Name="TrackingBox" Header="Prevención de seguimiento de WebView2" MinWidth="260" SelectionChanged="Setting_SelectionChanged"/>
            <TextBlock Text="Podés desactivar los escudos en un sitio puntual desde el botón 🛡 de la barra." Opacity="0.7" TextWrapping="Wrap"/>

            <TextBlock Text="Descargas" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <ToggleSwitch x:Name="AskSwitch" Header="Preguntar dónde guardar cada archivo" OnContent="Sí" OffContent="No" Toggled="Setting_Toggled"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                <Button Content="Cambiar carpeta…" Click="ChangeFolder_Click"/>
            </StackPanel>
            <TextBlock Text="La carpeta se usa cuando no se pregunta dónde guardar." Opacity="0.7"/>

            <TextBlock Text="Importar desde Google Chrome" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <ComboBox x:Name="ProfileBox" Header="Perfil de Chrome" MinWidth="260" DisplayMemberPath="Name"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="BookmarksCheck" Content="Marcadores" IsChecked="True"/>
                <CheckBox x:Name="HistoryCheck" Content="Historial" IsChecked="True"/>
            </StackPanel>
            <Button x:Name="ImportBtn" Content="Importar" Click="Import_Click"/>
            <TextBlock x:Name="ImportResult" TextWrapping="Wrap"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="Cerrá Chrome antes de importar. Las contraseñas, cookies y extensiones no se pueden importar todavía."/>

            <TextBlock Text="Permisos de sitios" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <TextBlock x:Name="PermEmpty" TextWrapping="Wrap" Opacity="0.7"
                       Text="Todavía no guardaste ningún permiso. Cuando un sitio pida cámara, micrófono, ubicación o notificaciones vas a poder recordar tu decisión."/>
            <ListView x:Name="PermList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="Quitar" Click="PermRemove_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Navegador predeterminado" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <Button Content="Registrar y abrir la configuración de Windows" Click="DefaultBrowser_Click"/>
            <TextBlock x:Name="DefaultResult" TextWrapping="Wrap" Opacity="0.7"
                       Text="Windows no deja que una app se ponga sola como predeterminada: se registra en la lista y vos lo elegís ahí."/>

            <TextBlock Text="Datos de navegación" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Borrar cookies, caché y datos de sitios" Click="ClearData_Click"/>
                <Button Content="Borrar historial" Click="ClearHistory_Click"/>
            </StackPanel>
            <TextBlock x:Name="ClearResult" Opacity="0.7"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
