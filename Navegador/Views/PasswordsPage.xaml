<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Navegador.Views.PasswordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Bloqueado: crear o desbloquear -->
        <ScrollViewer x:Name="LockedPanel">
            <StackPanel Padding="24" Spacing="12" MaxWidth="440" HorizontalAlignment="Left">
                <TextBlock Text="Contraseñas" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="LockedHint" TextWrapping="Wrap" Opacity="0.8"/>
                <PasswordBox x:Name="MasterBox" Header="Contraseña maestra" KeyDown="Master_KeyDown"/>
                <PasswordBox x:Name="MasterBox2" Header="Repetir la contraseña maestra" Visibility="Collapsed" KeyDown="Master_KeyDown"/>
                <Button x:Name="UnlockBtn" Style="{StaticResource AccentButtonStyle}" Click="Unlock_Click"/>
                <Button x:Name="HelloBtn" Content="Desbloquear con Windows Hello" Click="Hello_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="LockedError" Foreground="IndianRed" TextWrapping="Wrap"/>
                <HyperlinkButton x:Name="ForgotBtn" Content="Olvidé mi contraseña maestra" Click="Forgot_Click" Padding="0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Desbloqueado -->
        <Grid x:Name="OpenPanel" Padding="24" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Contraseñas" Style="{StaticResource TitleTextBlockStyle}"/>
                <Button Content="Bloquear" Click="Lock_Click" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Agregar" Click="Add_Click"/>
                <Button Content="Importar CSV (Chrome, Edge, Firefox…)" Click="Import_Click"/>
                <Button Content="Exportar CSV" Click="Export_Click"/>
                <Button Content="Cambiar la contraseña maestra" Click="ChangeMaster_Click"/>
                <Button x:Name="HelloToggleBtn" Click="HelloToggle_Click" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="SummaryText" Grid.Row="2" Opacity="0.7" TextWrapping="Wrap"/>
            <TextBox x:Name="SearchBox" Grid.Row="3" PlaceholderText="Buscar por nombre, sitio o usuario" TextChanged="SearchBox_TextChanged"/>

            <TextBlock x:Name="EmptyText" Grid.Row="4" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="No hay contraseñas guardadas. Agregá una, importá las de Chrome o iniciá sesión en un sitio y el navegador te ofrecerá guardarla."/>

            <ListView x:Name="ItemsList" Grid.Row="4" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Copiar usuario" Click="CopyUser_Click"/>
                                <Button Content="Copiar contraseña" Click="CopyPass_Click"/>
                                <Button Content="Ver" Click="Show_Click"/>
                                <Button Content="Editar" Click="Edit_Click"/>
                                <Button Content="Quitar" Click="Remove_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
